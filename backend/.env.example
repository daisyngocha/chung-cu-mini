# Lưu ý: khác định dạng với .env ở root (Prisma dùng "postgresql://", JDBC cần tiền tố "jdbc:").
DATABASE_URL="jdbc:postgresql://localhost:5432/database"
DATABASE_USERNAME="postgres"
DATABASE_PASSWORD="password"

# Khóa ký JWT riêng của backend này. Tạo bằng: openssl rand -base64 32
JWT_SECRET="doi-chuoi-nay-thanh-mot-khoa-bi-mat-dai-ngau-nhien"
