generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUM — nguồn: docs/5.DacTa_Class_ChungCuMini.xlsx, sheet 4_DanhMuc_Enum
// ============================================================

enum VaiTro {
  CHU_NHA
  KHACH_THUE
}

enum TrangThaiTK {
  HOAT_DONG
  KHOA_TAM
  DA_KHOA
}

enum TrangThaiPhong {
  TRONG
  DANG_THUE
  NGUNG_KHAI_THAC
}

enum LoaiKhoan {
  DIEN
  NUOC
  NUOC_THEO_NGUOI
  DICH_VU_THEO_PHONG
  DICH_VU_THEO_XE
}

enum TrangThaiHD {
  CHO_NHAN_PHONG
  HIEU_LUC
  DA_THANH_LY
}

enum LoaiKetThuc {
  KHACH_BAO_TRA
  HET_HAN
  CHAM_DUT_VI_PHAM
}

enum LoaiBanGiao {
  NHAN_PHONG
  TRA_PHONG
}

enum LoaiThayDoi {
  GIA_HAN
  DIEU_CHINH_GIA
  DIEU_CHINH_PHI
  THEM_NGUOI_O
  BOT_NGUOI_O
}

enum LoaiCongTo {
  DIEN
  NUOC
}

enum LoaiGhi {
  DAU_KY
  HANG_THANG
  CUOI_KY
}

enum LoaiThongBao {
  KY_HOP_DONG
  HANG_THANG
  THU_THEM_QUYET_TOAN
}

enum TrangThaiTBT {
  NHAP
  DA_PHAT_HANH
  CHO_XAC_NHAN
  DA_THU_MOT_PHAN
  DA_THU_DU
  QUA_HAN
  DA_HUY
}

enum LoaiKhoanTBT {
  TIEN_PHONG
  TIEN_COC
  DIEN
  NUOC
  DICH_VU
  PHI_PHAT_SINH
  GIAM_TRU
  DIEU_CHINH
}

enum TrangThaiBaoTT {
  CHO_XAC_NHAN
  DA_XAC_NHAN
  TU_CHOI
}

enum HinhThucTT {
  CHUYEN_KHOAN
  TIEN_MAT
}

enum TrangThaiPT {
  HIEU_LUC
  DA_HUY
}

enum TrangThaiQT {
  NHAP
  CHO_PHAN_HOI
  KHACH_KHONG_DONG_Y
  DA_CHOT
  HOAN_TAT
}

enum LoaiKhoanQT {
  TIEN_COC
  HOAN_TIEN_PHONG
  DIEN
  NUOC
  DICH_VU
  NO_CHUA_TRA
  BOI_THUONG_HU_HONG
  PHAT_TRA_TRUOC_HAN
  KHAC
}

enum LoaiSuCo {
  DIEN
  NUOC
  THIET_BI
  INTERNET
  KHAC
}

enum TrangThaiSuCo {
  MOI
  DANG_XU_LY
  DA_XU_LY
  TU_CHOI
  MO_LAI
}

enum LoaiSuKien {
  TB_TIEN_MOI
  NHAC_HAN_TT
  QUA_HAN_TT
  KHACH_BAO_CK
  XAC_NHAN_THU
  TU_CHOI_BAO_CK
  HD_SAP_HET_HAN
  SU_CO_MOI
  SU_CO_DOI_TRANG_THAI
  SU_CO_MO_LAI
  KHACH_BAO_TRA
  QUYET_TOAN_DA_GUI
  KHACH_PHAN_HOI_QT
  THONG_BAO_CHUNG
}

enum NguonTB {
  TU_DONG
  CHU_NHA
}

enum PhamViTB {
  CA_NHAN
  TOAN_TOA
}

// ============================================================
// M1 — Tài khoản và cấu hình tòa nhà (UC01) + Thông báo (M8)
// ============================================================

model ToaNha {
  maToa         String  @id @default("TOA01") @db.VarChar(10)
  tenToa        String  @db.VarChar(100)
  diaChi        String  @db.VarChar(255)
  noiQuy        String? @db.Text
  ngayChotChiSo Int     @default(31)
  hanThanhToan  Int     @default(5)
  nganHang      String  @db.VarChar(10)
  soTaiKhoan    String  @db.VarChar(20)
  chuTaiKhoan   String  @db.VarChar(100)
  tenChuNha     String  @db.VarChar(100)
  sdtChuNha     String  @db.VarChar(10)
  diaChiChuNha  String? @db.VarChar(255)

  phong   Phong[]
  bangGia BangGia[]
}

model TaiKhoan {
  maTaiKhoan     String      @id @db.VarChar(20)
  tenDangNhap    String      @unique @db.VarChar(10)
  matKhauHash    String      @db.VarChar(255)
  vaiTro         VaiTro
  trangThai      TrangThaiTK @default(HOAT_DONG)
  soLanSai       Int         @default(0)
  phaiDoiMatKhau Boolean     @default(true)
  ngayTao        DateTime    @default(now())
  khoaDenLuc     DateTime?

  nhatKyThaoTac     NhatKyThaoTac[]
  thongBaoNguoiNhan ThongBaoNguoiNhan[]
  hopDong           HopDong[]
}

model NhatKyThaoTac {
  maNhatKy   String    @id @db.VarChar(20)
  maTaiKhoan String?   @db.VarChar(20)
  taiKhoan   TaiKhoan? @relation(fields: [maTaiKhoan], references: [maTaiKhoan])
  thoiDiem   DateTime  @default(now())
  doiTuong   String    @db.VarChar(30)
  maDoiTuong String    @db.VarChar(20)
  hanhDong   String    @db.VarChar(30)
  noiDung    String?   @db.Text
}

model ThongBao {
  maThongBao       String     @id @db.VarChar(20)
  loaiSuKien       LoaiSuKien
  tieuDe           String     @db.VarChar(150)
  noiDung          String     @db.Text
  nguon            NguonTB    @default(TU_DONG)
  phamVi           PhamViTB   @default(CA_NHAN)
  doiTuongLienQuan String?    @db.VarChar(50)
  ngayTao          DateTime   @default(now())

  nguoiNhan ThongBaoNguoiNhan[]
}

model ThongBaoNguoiNhan {
  maThongBao  String    @db.VarChar(20)
  maTaiKhoan  String    @db.VarChar(20)
  thongBao    ThongBao  @relation(fields: [maThongBao], references: [maThongBao])
  taiKhoan    TaiKhoan  @relation(fields: [maTaiKhoan], references: [maTaiKhoan])
  daDoc       Boolean   @default(false)
  thoiDiemDoc DateTime?

  @@id([maThongBao, maTaiKhoan])
}

// ============================================================
// M2 — Phòng và bảng giá (UC02)
// ============================================================

model Phong {
  maPhong      String         @id @db.VarChar(10)
  maToa        String         @default("TOA01") @db.VarChar(10)
  toaNha       ToaNha         @relation(fields: [maToa], references: [maToa])
  tang         Int
  dienTich     Decimal        @db.Decimal(6, 2)
  soNguoiToiDa Int
  giaNiemYet   Decimal        @db.Decimal(15, 0)
  coCongToNuoc Boolean        @default(true)
  trangThai    TrangThaiPhong @default(TRONG)

  taiSan  TaiSan[]
  hopDong HopDong[]
  suCo    SuCo[]
}

model TaiSan {
  maTaiSan  String  @id @db.VarChar(20)
  maPhong   String  @db.VarChar(10)
  phong     Phong   @relation(fields: [maPhong], references: [maPhong])
  tenTaiSan String  @db.VarChar(100)
  soLuong   Int     @default(1)
  tinhTrang String  @default("Tốt") @db.VarChar(255)
  ghiChu    String? @db.VarChar(500)

  banGiaoTaiSan BanGiaoTaiSan[]
}

model BangGia {
  maKhoan        String    @id @db.VarChar(20)
  maToa          String    @default("TOA01") @db.VarChar(10)
  toaNha         ToaNha    @relation(fields: [maToa], references: [maToa])
  tenKhoan       String    @db.VarChar(100)
  loaiKhoan      LoaiKhoan
  donGia         Decimal   @db.Decimal(15, 0)
  donViTinh      String    @db.VarChar(20)
  ngayApDung     DateTime  @db.Date
  ngayHetHieuLuc DateTime? @db.Date

  hopDongDichVu HopDongDichVu[]
}

// ============================================================
// M3 — Khách thuê, hợp đồng và nhận phòng (UC03)
// ============================================================

model KhachThue {
  maKhach     String   @id @db.VarChar(20)
  soDienThoai String   @unique @db.VarChar(10)
  hoTen       String   @db.VarChar(100)
  ngaySinh    DateTime @db.Date
  soCCCD      String   @db.VarChar(12)
  anhCCCD     String?  @db.VarChar(500)
  queQuan     String?  @db.VarChar(255)
  noiLamViec  String?  @db.VarChar(255)

  hopDong HopDong[]
}

model HopDong {
  maHopDong              String       @id @db.VarChar(20)
  maPhong                String       @db.VarChar(10)
  phong                  Phong        @relation(fields: [maPhong], references: [maPhong])
  maKhach                String       @db.VarChar(20)
  khachThue              KhachThue    @relation(fields: [maKhach], references: [maKhach])
  maTaiKhoan             String?      @db.VarChar(20)
  taiKhoan               TaiKhoan?    @relation(fields: [maTaiKhoan], references: [maTaiKhoan])
  maNguoiOCapTK          String?      @db.VarChar(20)
  nguoiOCapTK            NguoiO?      @relation("NguoiOCapTK", fields: [maNguoiOCapTK], references: [maNguoiO])
  ngayBatDau             DateTime     @db.Date
  ngayHetHan             DateTime     @db.Date
  giaThue                Decimal      @db.Decimal(15, 0)
  tienCoc                Decimal      @db.Decimal(15, 0)
  mucPhatTraTruoc        Decimal      @default(0) @db.Decimal(15, 0)
  anhHopDong             String?      @db.VarChar(1000)
  ngayNhanPhong          DateTime?    @db.Date
  ngayBaoTra             DateTime?    @db.Date
  ngayTraDuKien          DateTime?    @db.Date
  ngayTraThucTe          DateTime?    @db.Date
  trangThai              TrangThaiHD  @default(CHO_NHAN_PHONG)
  lyDoNhanPhongChuaThuDu String?      @db.VarChar(500)
  loaiKetThuc            LoaiKetThuc?
  daThuHoiChiaKhoa       Boolean      @default(false)

  nguoiO        NguoiO[]        @relation("HopDongNguoiO")
  hopDongDichVu HopDongDichVu[]
  banGiaoTaiSan BanGiaoTaiSan[]
  lichSuHopDong LichSuHopDong[]
  chiSo         ChiSo[]
  thongBaoTien  ThongBaoTien[]
  quyetToan     QuyetToan?
}

model NguoiO {
  maNguoiO    String    @id @db.VarChar(20)
  maHopDong   String    @db.VarChar(20)
  hopDong     HopDong   @relation("HopDongNguoiO", fields: [maHopDong], references: [maHopDong])
  hoTen       String    @db.VarChar(100)
  soCCCD      String?   @db.VarChar(12)
  soDienThoai String?   @db.VarChar(10)
  ngayVao     DateTime  @db.Date
  ngayRa      DateTime? @db.Date

  hopDongCapTK HopDong[] @relation("NguoiOCapTK")
}

model HopDongDichVu {
  maHopDong  String   @db.VarChar(20)
  maKhoan    String   @db.VarChar(20)
  hopDong    HopDong  @relation(fields: [maHopDong], references: [maHopDong])
  bangGia    BangGia  @relation(fields: [maKhoan], references: [maKhoan])
  soLuong    Int      @default(1)
  mucPhi     Decimal  @db.Decimal(15, 0)
  ngayApDung DateTime @db.Date

  @@id([maHopDong, maKhoan])
}

model BanGiaoTaiSan {
  maBanGiao    String      @id @db.VarChar(20)
  maHopDong    String      @db.VarChar(20)
  hopDong      HopDong     @relation(fields: [maHopDong], references: [maHopDong])
  maTaiSan     String      @db.VarChar(20)
  taiSan       TaiSan      @relation(fields: [maTaiSan], references: [maTaiSan])
  loaiBanGiao  LoaiBanGiao
  ngayBanGiao  DateTime    @default(now()) @db.Date
  tinhTrang    String      @db.VarChar(255)
  anh          String?     @db.VarChar(1000)
  chiPhiHuHong Decimal     @default(0) @db.Decimal(15, 0)
}

model LichSuHopDong {
  maLichSu      String      @id @db.VarChar(20)
  maHopDong     String      @db.VarChar(20)
  hopDong       HopDong     @relation(fields: [maHopDong], references: [maHopDong])
  ngayThayDoi   DateTime    @default(now()) @db.Date
  loaiThayDoi   LoaiThayDoi
  truongThayDoi String      @db.VarChar(50)
  giaTriCu      String?     @db.VarChar(500)
  giaTriMoi     String?     @db.VarChar(500)
  ngayApDung    DateTime    @db.Date
  anhPhuLuc     String?     @db.VarChar(1000)
}

model ChiSo {
  maChiSo    String     @id @db.VarChar(20)
  maHopDong  String     @db.VarChar(20)
  hopDong    HopDong    @relation(fields: [maHopDong], references: [maHopDong])
  loaiCongTo LoaiCongTo
  kyThang    String     @db.Char(7)
  loaiGhi    LoaiGhi    @default(HANG_THANG)
  ngayGhi    DateTime   @default(now()) @db.Date
  chiSoCu    Int
  chiSoMoi   Int
  anhCongTo  String?    @db.VarChar(500)

  dongThongBaoTien DongThongBaoTien[]

  @@unique([maHopDong, loaiCongTo, kyThang, loaiGhi])
}

// ============================================================
// M5 — Chỉ số điện nước và thông báo tiền (UC05)
// M6 — Thanh toán và phiếu thu (UC06)
// ============================================================

model ThongBaoTien {
  maThongBaoTien String       @id @db.VarChar(20)
  maHopDong      String       @db.VarChar(20)
  hopDong        HopDong      @relation(fields: [maHopDong], references: [maHopDong])
  maQuyetToan    String?      @unique @db.VarChar(20)
  quyetToan      QuyetToan?   @relation(fields: [maQuyetToan], references: [maQuyetToan])
  loaiThongBao   LoaiThongBao @default(HANG_THANG)
  kyThang        String       @db.Char(7)
  ngayPhatHanh   DateTime?    @db.Date
  hanThanhToan   DateTime     @db.Date
  noCu           Decimal      @default(0) @db.Decimal(15, 0)
  tongTien       Decimal      @db.Decimal(15, 0)
  soDaThu        Decimal      @default(0) @db.Decimal(15, 0)
  trangThai      TrangThaiTBT @default(NHAP)
  lyDoHuy        String?      @db.VarChar(500)

  dongThongBaoTien DongThongBaoTien[] @relation("ThongBaoTien_Dong")
  dieuChinhTu      DongThongBaoTien[] @relation("ThongBaoTien_DieuChinhGoc")
  baoThanhToan     BaoThanhToan[]
  phieuThu         PhieuThu[]
}

model DongThongBaoTien {
  maDong            String        @id @db.VarChar(20)
  maThongBaoTien    String        @db.VarChar(20)
  thongBaoTien      ThongBaoTien  @relation("ThongBaoTien_Dong", fields: [maThongBaoTien], references: [maThongBaoTien])
  maChiSo           String?       @db.VarChar(20)
  chiSo             ChiSo?        @relation(fields: [maChiSo], references: [maChiSo])
  maSuCo            String?       @db.VarChar(20)
  suCo              SuCo?         @relation(fields: [maSuCo], references: [maSuCo])
  maThongBaoTienGoc String?       @db.VarChar(20)
  thongBaoTienGoc   ThongBaoTien? @relation("ThongBaoTien_DieuChinhGoc", fields: [maThongBaoTienGoc], references: [maThongBaoTien])
  loaiKhoan         LoaiKhoanTBT
  dienGiai          String        @db.VarChar(255)
  tuNgay            DateTime?     @db.Date
  denNgay           DateTime?     @db.Date
  soLuong           Decimal       @default(1) @db.Decimal(10, 2)
  donGia            Decimal       @db.Decimal(15, 0)
  tyLeNgayO         Decimal       @default(1) @db.Decimal(7, 6)
  thanhTien         Decimal       @db.Decimal(15, 2)
}

model BaoThanhToan {
  maBaoTT        String         @id @db.VarChar(20)
  maThongBaoTien String         @db.VarChar(20)
  thongBaoTien   ThongBaoTien   @relation(fields: [maThongBaoTien], references: [maThongBaoTien])
  thoiDiemBao    DateTime       @default(now())
  anhBienLai     String?        @db.VarChar(500)
  trangThai      TrangThaiBaoTT @default(CHO_XAC_NHAN)
  lyDoTuChoi     String?        @db.VarChar(500)

  phieuThu PhieuThu?
}

model PhieuThu {
  soPhieuThu     String        @id @db.VarChar(20)
  maThongBaoTien String        @db.VarChar(20)
  thongBaoTien   ThongBaoTien  @relation(fields: [maThongBaoTien], references: [maThongBaoTien])
  maBaoTT        String?       @unique @db.VarChar(20)
  baoThanhToan   BaoThanhToan? @relation(fields: [maBaoTT], references: [maBaoTT])
  ngayThu        DateTime      @default(now()) @db.Date
  nguoiNop       String        @db.VarChar(100)
  soTien         Decimal       @db.Decimal(15, 0)
  hinhThuc       HinhThucTT
  trangThai      TrangThaiPT   @default(HIEU_LUC)
  lyDoHuy        String?       @db.VarChar(500)
}

// ============================================================
// M4 — Gia hạn, trả phòng và quyết toán cọc (UC04)
// ============================================================

model QuyetToan {
  maQuyetToan      String      @id @db.VarChar(20)
  maHopDong        String      @unique @db.VarChar(20)
  hopDong          HopDong     @relation(fields: [maHopDong], references: [maHopDong])
  ngayTra          DateTime    @db.Date
  tienCoc          Decimal     @db.Decimal(15, 0)
  tienPhongHoanLai Decimal     @default(0) @db.Decimal(15, 0)
  tongKhauTru      Decimal     @default(0) @db.Decimal(15, 0)
  soTienQuyetToan  Decimal     @db.Decimal(15, 0)
  trangThai        TrangThaiQT @default(NHAP)
  lyDoDieuChinh    String?     @db.VarChar(500)
  khachDongY       Boolean?
  yKienKhach       String?     @db.VarChar(500)
  thoiDiemPhanHoi  DateTime?

  dongQuyetToan DongQuyetToan[]
  phieuChi      PhieuChi?
  thongBaoTien  ThongBaoTien?
}

model DongQuyetToan {
  maDong       String      @id @db.VarChar(20)
  maQuyetToan  String      @db.VarChar(20)
  quyetToan    QuyetToan   @relation(fields: [maQuyetToan], references: [maQuyetToan])
  loaiKhoan    LoaiKhoanQT
  soTien       Decimal     @db.Decimal(15, 2)
  ghiChu       String?     @db.VarChar(500)
  anhBangChung String?     @db.VarChar(1000)
}

model PhieuChi {
  soPhieuChi  String     @id @db.VarChar(20)
  maQuyetToan String     @unique @db.VarChar(20)
  quyetToan   QuyetToan  @relation(fields: [maQuyetToan], references: [maQuyetToan])
  ngayChi     DateTime   @default(now()) @db.Date
  nguoiNhan   String     @db.VarChar(100)
  soTien      Decimal    @db.Decimal(15, 0)
  hinhThuc    HinhThucTT
}

// ============================================================
// M7 — Sự cố (UC07)
// ============================================================

model SuCo {
  maSuCo     String        @id @db.VarChar(20)
  maPhong    String        @db.VarChar(10)
  phong      Phong         @relation(fields: [maPhong], references: [maPhong])
  loaiSuCo   LoaiSuCo
  moTa       String        @db.VarChar(1000)
  anh        String?       @db.VarChar(1000)
  ngayBao    DateTime      @default(now())
  lichHen    DateTime?
  ketQua     String?       @db.VarChar(1000)
  chiPhi     Decimal       @default(0) @db.Decimal(15, 0)
  doKhachGay Boolean       @default(false)
  trangThai  TrangThaiSuCo @default(MOI)
  lyDoTuChoi String?       @db.VarChar(500)

  lichSuSuCo       LichSuSuCo[]
  dongThongBaoTien DongThongBaoTien[]
}

model LichSuSuCo {
  maLichSu       String         @id @db.VarChar(20)
  maSuCo         String         @db.VarChar(20)
  suCo           SuCo           @relation(fields: [maSuCo], references: [maSuCo])
  thoiDiem       DateTime       @default(now())
  trangThaiCu    TrangThaiSuCo?
  trangThaiMoi   TrangThaiSuCo
  vaiTroThucHien VaiTro
  ghiChu         String?        @db.VarChar(1000)
}
