# Chuỗi kết nối đến cơ sở dữ liệu PostgreSQL (Dùng cho quá trình chạy app)
DATABASE_URL="postgresql://user:password@host:port/database"
SEED_ADMIN_PASSWORD="password" # Mật khẩu cho tài khoản admin khi seed dữ liệu

# (Tùy chọn) Nếu dùng Supabase/Neon có pooler, dùng chuỗi này cho lệnh migrate
# DIRECT_URL="postgresql://user:password@host:5432/database"

# Khóa bí mật dùng để ký/verify session JWT. PHẢI giống "JWT_SECRET" trong
# backend/.env — Java ký token, proxy.ts (Next.js) chỉ verify, không tự ký nữa.
# Tạo bằng: openssl rand -base64 32
SESSION_SECRET="doi-chuoi-nay-thanh-mot-khoa-bi-mat-dai-ngau-nhien"

# Địa chỉ backend Spring Boot (chỉ Next.js server gọi, browser không gọi trực tiếp)
BACKEND_URL="http://localhost:8080"
