# Chuỗi kết nối đến cơ sở dữ liệu PostgreSQL (Dùng cho quá trình chạy app)
DATABASE_URL="postgresql://user:password@host:port/database"
SEED_ADMIN_PASSWORD="password" # Mật khẩu cho tài khoản admin khi seed dữ liệu

# (Tùy chọn) Nếu dùng Supabase/Neon có pooler, dùng chuỗi này cho lệnh migrate
# DIRECT_URL="postgresql://user:password@host:5432/database"

# Khóa bí mật dùng để ký session đăng nhập (JWT). Tạo bằng: openssl rand -base64 32
SESSION_SECRET="doi-chuoi-nay-thanh-mot-khoa-bi-mat-dai-ngau-nhien"
